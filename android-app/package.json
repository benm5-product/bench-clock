{
  "name": "bench-clock",
  "private": true,
  "description": "Bench Clock's Android app: the web app from the repo root, packaged with Capacitor.",
  "scripts": {
    "sync": "node scripts/copy-web.mjs && cap sync android",
    "build:apk": "npm run sync && cd android && ./gradlew assembleRelease && node ../scripts/name-apk.mjs",
    "assets": "node scripts/make-icon.mjs && capacitor-assets generate --android --iconBackgroundColor '#1f4d32' --iconBackgroundColorDark '#1f4d32' --splashBackgroundColor '#1f4d32' --splashBackgroundColorDark '#0e1410'",
    "serve": "node scripts/copy-web.mjs && node scripts/serve.mjs",
    "test:web": "node tests/web-smoke.mjs",
    "test:iphone": "node tests/iphone-web.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0"
  }
}
